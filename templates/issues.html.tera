{% extends "base" %}

{% block content %}
<style>
    .issues-header { margin-bottom: 20px; }
    .summary-cards {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }
    .card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        padding: 12px 18px;
        min-width: 120px;
    }
    .card-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #888; margin-bottom: 2px; }
    .card-value { font-size: 26px; font-weight: bold; color: #333; }
    .type-summary {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        padding: 14px 18px;
        margin-bottom: 20px;
    }
    .type-summary h4 {
        margin: 0 0 10px 0;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #666;
    }
    .type-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 0;
        border-bottom: 1px solid #f5f5f5;
        font-size: 13px;
    }
    .type-row:last-child { border-bottom: none; }
    .type-count { font-weight: bold; min-width: 36px; text-align: right; }
    .badge-sev {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: bold;
        white-space: nowrap;
    }
    .badge-error   { background: #f8d7da; color: #721c24; }
    .badge-warning { background: #fff3cd; color: #856404; }
    .badge-info    { background: #d1ecf1; color: #0c5460; }
    .kb-group {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        margin-bottom: 14px;
        overflow: hidden;
    }
    .kb-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        cursor: pointer;
        user-select: none;
        background: #343a40;
        color: white;
        gap: 12px;
    }
    .kb-group-header:hover { background: #23272b; }
    .kb-group-name { font-weight: bold; font-size: 14px; }
    .kb-issue-count {
        background: rgba(255,255,255,0.18);
        border-radius: 10px;
        padding: 2px 9px;
        font-size: 12px;
        margin-left: auto;
    }
    .expand-icon { font-size: 12px; opacity: 0.7; transition: transform 0.2s; }
    .expand-icon.open { transform: rotate(90deg); }
    .kb-group-body { display: none; }
    .issues-table {
        width: 100%;
        border-collapse: collapse;
    }
    .issues-table th {
        background: #f8f9fa;
        color: #495057;
        padding: 8px 12px;
        text-align: left;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid #dee2e6;
    }
    .issues-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 13px;
        vertical-align: top;
    }
    .issues-table tr:last-child td { border-bottom: none; }
    .path-cell {
        font-family: 'Courier New', monospace;
        font-size: 11px;
        color: #555;
        max-width: 200px;
        word-break: break-all;
    }
    .val-cell {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 12px;
        color: #333;
        cursor: pointer;
    }
    .val-cell.expanded { white-space: normal; overflow: visible; }
    .detail-cell { color: #555; font-size: 12px; max-width: 260px; }
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }
    .empty-state h4 { margin-bottom: 8px; color: #555; }
    .empty-state code {
        background: #f8f9fa;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 13px;
    }
</style>

<h3 style="margin-bottom:18px">
    Validation Issues
    {% if total > 0 %}<span style="font-size:15px;color:#888;font-weight:normal">&nbsp;{{ total }} total</span>{% endif %}
</h3>

{% if total == 0 %}
<div class="kb-group">
    <div class="empty-state">
        <h4>No issues on record</h4>
        <p>Run the validation script before launching the dashboard:</p>
        <p style="margin-top:6px"><code>python3 scripts/validate_all.py</code></p>
        <p style="margin-top:8px;font-size:12px;color:#bbb">Then reload this page.</p>
    </div>
</div>
{% else %}

<!-- Issue type breakdown -->
<div class="type-summary">
    <h4>By issue type</h4>
    {% for t in by_type %}
    <div class="type-row">
        <span class="badge-sev badge-{{ t.severity }}">{{ t.label }}</span>
        <span class="type-count">{{ t.count }}</span>
        <span style="color:#bbb;font-size:11px;font-family:monospace">{{ t.issue_type }}</span>
    </div>
    {% endfor %}
</div>

<!-- KB groups (collapsed by default) -->
{% for group in kb_groups %}
<div class="kb-group">
    <div class="kb-group-header" onclick="toggleGroup(this)">
        <span class="kb-group-name">{{ group.kb_name }}</span>
        <span class="kb-issue-count">{{ group.count }} issue{% if group.count != 1 %}s{% endif %}</span>
        <span class="expand-icon">▶</span>
    </div>
    <div class="kb-group-body">
        <table class="issues-table">
            <thead>
                <tr>
                    <th style="width:160px">Issue</th>
                    <th style="width:200px">Path</th>
                    <th style="width:200px">Value</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                {% for iss in group.issues %}
                <tr>
                    <td><span class="badge-sev badge-{{ iss.severity }}">{{ iss.issue_label }}</span></td>
                    <td class="path-cell" title="{{ iss.path }}">{{ iss.path }}</td>
                    <td class="val-cell" title="{{ iss.value }}" onclick="this.classList.toggle('expanded')">{{ iss.value }}</td>
                    <td class="detail-cell">{{ iss.detail }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endfor %}

<script>
function toggleGroup(header) {
    var body = header.nextElementSibling;
    var icon = header.querySelector('.expand-icon');
    var open = body.style.display === 'block';
    body.style.display = open ? 'none' : 'block';
    icon.classList.toggle('open', !open);
}
</script>

{% endif %}

{% endblock content %}
