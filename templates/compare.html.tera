{% extends "base" %}

{% block content %}
<style>
    .compare-header { margin-bottom: 18px; }
    .run-legend {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .run-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
    }
    .run-chip-num {
        background: #495057;
        color: white;
        border-radius: 10px;
        padding: 1px 6px;
        font-size: 11px;
        font-weight: bold;
    }
    .compare-stats {
        display: flex;
        gap: 16px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }
    .cstat {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        padding: 10px 18px;
        font-size: 13px;
    }
    .cstat strong { font-size: 22px; display: block; color: #333; }
    .compare-table-wrap {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        overflow-x: auto;
        margin-bottom: 20px;
    }
    .compare-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }
    .compare-table th {
        background: #495057;
        color: white;
        padding: 8px 12px;
        text-align: left;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }
    .compare-table th.run-col {
        background: #343a40;
        font-size: 11px;
        max-width: 200px;
    }
    .compare-table td {
        padding: 7px 12px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 12px;
        vertical-align: top;
    }
    .compare-table tr:last-child td { border-bottom: none; }
    .path-col {
        font-family: 'Courier New', monospace;
        font-size: 11px;
        color: #555;
        white-space: nowrap;
        width: 220px;
    }
    .val-col {
        max-width: 200px;
        word-break: break-word;
        font-size: 12px;
        cursor: pointer;
    }
    .val-missing { color: #ccc; font-style: italic; font-size: 11px; }
    .val-changed { background: #fff8e1; }
    .val-same    { background: #f0faf2; }
    .val-added   { background: #e8f4ff; }
    .val-removed { background: #fff0f0; }
    .val-full    { display: none; white-space: pre-wrap; word-break: break-word; }
    .row-same td { opacity: 0.6; }
    .row-target  { outline: 2px solid #ffc107; }
    .row-target td { background: #fffde7 !important; }
    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 0;
        font-size: 13px;
    }
    .btn-page {
        padding: 5px 14px;
        border-radius: 4px;
        font-size: 13px;
        text-decoration: none;
        background: #007bff;
        color: white;
        border: none;
        cursor: pointer;
    }
    .btn-page:hover { background: #0069d9; }
    .btn-page.disabled {
        background: #c8d6e0;
        pointer-events: none;
    }
    .filter-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }
    .filter-bar label { font-size: 13px; color: #555; cursor: pointer; }
    .empty-state {
        text-align: center; padding: 60px 20px; color: #888;
        background: #fff; border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
    }
</style>

<div class="compare-header">
    <h3 style="margin-bottom:6px">Compare: {{ kb_name }}</h3>
    <div style="font-size:13px;color:#888">Field values across all imported runs</div>
</div>

{% if runs | length == 0 %}
<div class="empty-state">
    <h4>No runs imported yet</h4>
    <p style="margin-top:8px">Import pipeline runs first:</p>
    <p style="margin-top:6px;font-family:monospace;font-size:13px">python3 scripts/import_run.py /path/to/run/</p>
    <p style="margin-top:12px"><a href="/runs">Go to Runs page →</a></p>
</div>
{% else %}

<!-- Run legend -->
<div class="run-legend">
    {% for run in runs %}
    <div class="run-chip">
        <span class="run-chip-num">R{{ loop.index }}</span>
        <span>{{ run.label }}</span>
        {% if run.run_date %}<span style="color:#aaa">{{ run.run_date }}</span>{% endif %}
        {% if run.model %}<span style="color:#888;font-style:italic">{{ run.model }}</span>{% endif %}
    </div>
    {% endfor %}
</div>

<div class="compare-stats">
    <div class="cstat">
        <strong>{{ total_changed }}</strong>
        Fields with changed values across runs
    </div>
    <div class="cstat">
        <strong>{{ runs | length }}</strong>
        Runs compared
    </div>
</div>

{% if total_changed == 0 %}
<div class="empty-state" style="padding:30px">
    <h4>No differences found</h4>
    <p>All fields in <strong>{{ kb_name }}</strong> have identical values across all imported runs.</p>
</div>
{% else %}

<div class="filter-bar">
    <label>
        <input type="checkbox" id="hide-same" onchange="toggleSame(this.checked)" checked>
        Hide identical rows
    </label>
    <span style="font-size:12px;color:#aaa">
        Page {{ current_page + 1 }} of {{ total_pages }}
        &nbsp;·&nbsp; {{ total_changed }} total changed fields
    </span>
</div>

<div class="compare-table-wrap">
    <table class="compare-table" id="compare-tbl">
        <thead>
            <tr>
                <th>Field path</th>
                {% for run in runs %}
                <th class="run-col">
                    R{{ loop.index }} {{ run.label }}
                    {% if run.run_date %}<br><span style="font-weight:normal;opacity:0.7">{{ run.run_date }}</span>{% endif %}
                </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
            <tr id="field-{{ row.anchor }}" class="{% if row.all_same %}row-same{% endif %}">
                <td class="path-col" title="{{ row.path }}">{{ row.path }}</td>
                {% for v in row.values %}
                <td class="val-col {% if not v.present %}val-removed{% elif row.all_same %}val-same{% else %}val-changed{% endif %}"
                    title="{{ v.value }}"
                    {% if v.present %}onclick="toggleValExpand(this)"{% endif %}>
                    {% if v.present %}
                        <span class="val-short">{{ v.value | truncate(length=120) }}</span>
                        <span class="val-full">{{ v.value }}</span>
                    {% else %}
                        <span class="val-missing">— not in this run</span>
                    {% endif %}
                </td>
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% if total_pages > 1 %}
<div class="pagination">
    {% if current_page > 0 %}
    <a class="btn-page" href="/compare/{{ kb_name | urlencode }}?page={{ current_page - 1 }}">← Previous</a>
    {% else %}
    <span class="btn-page disabled">← Previous</span>
    {% endif %}

    <span style="color:#666;font-size:13px">Page {{ current_page + 1 }} of {{ total_pages }}</span>

    {% if current_page + 1 < total_pages %}
    <a class="btn-page" href="/compare/{{ kb_name | urlencode }}?page={{ current_page + 1 }}">Next →</a>
    {% else %}
    <span class="btn-page disabled">Next →</span>
    {% endif %}
</div>
{% endif %}

<script>
function toggleSame(hide) {
    document.querySelectorAll('#compare-tbl .row-same').forEach(function(row) {
        row.style.display = hide ? 'none' : '';
    });
}
toggleSame(true);

function toggleValExpand(td) {
    var s = td.querySelector('.val-short');
    var f = td.querySelector('.val-full');
    if (!s || !f) return;
    var expanding = f.style.display !== 'block';
    s.style.display = expanding ? 'none' : '';
    f.style.display = expanding ? 'block' : 'none';
    td.style.maxWidth  = expanding ? 'none' : '';
}

document.addEventListener('DOMContentLoaded', function() {
    var hash = window.location.hash;
    if (!hash) return;
    var el = document.querySelector(hash);
    if (!el) return;
    el.classList.add('row-target');
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
});
</script>

{% endif %}
{% endif %}

{% endblock content %}
